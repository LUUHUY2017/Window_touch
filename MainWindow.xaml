<Window x:Class="IDE_Touch_Window.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IDE_Touch_Window"
        mc:Ignorable="d"
        Title="FloatingIcon" 
        Height="380" Width="380"
        Topmost="True"
        AllowsTransparency="True" 
        WindowStyle="None" 
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Base Button Template -->
        <ControlTemplate x:Key="AnimatedButtonTemplate" TargetType="Button">
            <Border x:Name="border" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="21"
                    Padding="{TemplateBinding Padding}">
                <Border.Effect>
                    <DropShadowEffect x:Name="shadow" BlurRadius="16" ShadowDepth="4" Opacity="0.55" Color="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                </Border.Effect>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 📸 Screenshot Button Style (Sunset Pink-Purple Gradient) -->
        <Style x:Key="ScreenshotButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="16,0,18,0"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#FFF472B6"/>
            <Setter Property="Tag" Value="#EC4899"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FCE2E8F0" Offset="0"/>
                        <GradientStop Color="#FCEC4899" Offset="0.3"/>
                        <GradientStop Color="#FC8B5CF6" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template" Value="{StaticResource AnimatedButtonTemplate}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.07" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.07" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 🖥️ Desktop Button Style (Electric Emerald-Teal Gradient) -->
        <Style x:Key="DesktopButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="16,0,18,0"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#FF34D399"/>
            <Setter Property="Tag" Value="#10B981"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FC06B6D4" Offset="0"/>
                        <GradientStop Color="#FC10B981" Offset="0.6"/>
                        <GradientStop Color="#FC059669" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template" Value="{StaticResource AnimatedButtonTemplate}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.07" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.07" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 💻 Command Prompt Button Style (Cosmic Neon Indigo Gradient) -->
        <Style x:Key="CommandPromptButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="16,0,18,0"/>
            <Setter Property="MinWidth" Value="125"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#FFA5B4FC"/>
            <Setter Property="Tag" Value="#6366F1"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FC6366F1" Offset="0"/>
                        <GradientStop Color="#FC3B82F6" Offset="0.5"/>
                        <GradientStop Color="#FC1D4ED8" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template" Value="{StaticResource AnimatedButtonTemplate}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.07" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.07" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <!-- Central Main Icon Card with Bounce RenderTransform (ZIndex 1) -->
        <Grid x:Name="MainIconGrid" 
              Width="210" Height="270" 
              HorizontalAlignment="Center" 
              VerticalAlignment="Center" 
              Panel.ZIndex="1"
              Cursor="Hand"
              RenderTransformOrigin="0.5,1.0"
              PreviewMouseLeftButtonDown="MainIcon_PreviewMouseLeftButtonDown"
              PreviewMouseMove="MainIcon_PreviewMouseMove"
              PreviewMouseLeftButtonUp="MainIcon_PreviewMouseLeftButtonUp">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="IconScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                    <TranslateTransform x:Name="IconTranslateTransform" X="0" Y="0"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <Image x:Name="IconImage" Width="210" Height="270" Stretch="Uniform"/>
            <TextBlock x:Name="FallbackText" Text="🌸" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>

        <!-- Circular Sub-Menu Canvas (ZIndex 100) -->
        <Canvas x:Name="MenuCanvas" Width="360" Height="360" Panel.ZIndex="100" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="MenuScale" ScaleX="0.2" ScaleY="0.2"/>
                    <RotateTransform Angle="0"/>
                </TransformGroup>
            </Canvas.RenderTransform>

            <Button x:Name="BtnScreenshot" 
                    Canvas.Left="100" Canvas.Top="15" 
                    Content="📸  Chụp màn hình" 
                    Style="{StaticResource ScreenshotButtonStyle}" 
                    Click="BtnScreenshot_Click"/>

            <Button x:Name="BtnDesktop" 
                    Canvas.Left="10" Canvas.Top="160" 
                    Content="🖥️  Desktop" 
                    Style="{StaticResource DesktopButtonStyle}" 
                    Click="BtnDesktop_Click"/>

            <Button x:Name="BtnCommandPrompt" 
                    Canvas.Left="190" Canvas.Top="160" 
                    Content="💻  Command Prompt" 
                    Style="{StaticResource CommandPromptButtonStyle}" 
                    Click="BtnCommandPrompt_Click"/>
        </Canvas>

        <!-- Notification Toast Banner (ZIndex 200) -->
        <Border x:Name="ToastNotification" 
                Panel.ZIndex="200"
                Height="36" 
                Background="#F0059669" 
                CornerRadius="18" 
                Padding="16,0,16,0"
                VerticalAlignment="Top" 
                HorizontalAlignment="Center" 
                Margin="0,12,0,0" 
                Visibility="Collapsed" 
                Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4" Color="#000000"/>
            </Border.Effect>
            <TextBlock x:Name="ToastText" 
                       Text="✨ Thông báo" 
                       Foreground="White" 
                       FontWeight="Bold" 
                       FontSize="12" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Manga / Anime Style Speech Bubble (Chat Bubble) (ZIndex 150) -->
        <Border x:Name="ChatBubble" 
                Panel.ZIndex="150"
                MaxWidth="260" 
                Background="#F20F172A" 
                BorderBrush="#FF38BDF8" 
                BorderThickness="1.5"
                CornerRadius="16" 
                Padding="16,12,16,12" 
                VerticalAlignment="Top" 
                HorizontalAlignment="Center" 
                Margin="0,15,0,0" 
                Visibility="Collapsed" 
                Opacity="0"
                Cursor="Hand"
                MouseLeftButtonDown="ChatBubble_MouseLeftButtonDown"
                RenderTransformOrigin="0.5,1.0">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ChatBubbleScale" ScaleX="0.3" ScaleY="0.3"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.6" Color="#38BDF8"/>
            </Border.Effect>

            <TextBlock x:Name="ChatText" 
                       Text="" 
                       Foreground="White" 
                       FontWeight="SemiBold" 
                       FontSize="13" 
                       TextWrapping="Wrap" 
                       LineHeight="19"/>
        </Border>
    </Grid>
</Window>
