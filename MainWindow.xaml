<Window x:Class="IDE_Touch_Window.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IDE_Touch_Window"
        mc:Ignorable="d"
        Title="FloatingIcon" 
        Height="380" Width="380"
        Topmost="True"
        AllowsTransparency="True" 
        WindowStyle="None" 
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Premium Modern Rounded Action Button Style -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F20F172A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#FF38BDF8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0,16,0"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.6" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1E293B"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF0284C7"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <!-- Central Main Icon Card (ZIndex 1) -->
        <Grid x:Name="MainIconGrid" 
              Width="210" Height="270" 
              HorizontalAlignment="Center" 
              VerticalAlignment="Center" 
              Panel.ZIndex="1"
              Cursor="Hand"
              PreviewMouseLeftButtonDown="MainIcon_PreviewMouseLeftButtonDown"
              PreviewMouseMove="MainIcon_PreviewMouseMove"
              PreviewMouseLeftButtonUp="MainIcon_PreviewMouseLeftButtonUp">
            
            <Image x:Name="IconImage" Width="210" Height="270" Stretch="Uniform"/>
            <TextBlock x:Name="FallbackText" Text="🌸" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>

        <!-- Circular Sub-Menu Canvas (ZIndex 100 so buttons are clickable over MainIconGrid) -->
        <Canvas x:Name="MenuCanvas" Width="360" Height="360" Panel.ZIndex="100" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="MenuScale" ScaleX="0.2" ScaleY="0.2"/>
                    <RotateTransform Angle="0"/>
                </TransformGroup>
            </Canvas.RenderTransform>

            <Button x:Name="BtnScreenshot" 
                    Canvas.Left="105" Canvas.Top="15" 
                    Content="📸  Chụp màn hình" 
                    Style="{StaticResource MenuButtonStyle}" 
                    Click="BtnScreenshot_Click"/>

            <Button x:Name="BtnDesktop" 
                    Canvas.Left="10" Canvas.Top="160" 
                    Content="🖥️  Desktop" 
                    Style="{StaticResource MenuButtonStyle}" 
                    Click="BtnDesktop_Click"/>

            <Button x:Name="BtnCommandPrompt" 
                    Canvas.Left="195" Canvas.Top="160" 
                    Content="💻  Command Prompt" 
                    Style="{StaticResource MenuButtonStyle}" 
                    Click="BtnCommandPrompt_Click"/>
        </Canvas>

        <!-- Notification Toast Banner (ZIndex 200) -->
        <Border x:Name="ToastNotification" 
                Panel.ZIndex="200"
                Height="36" 
                Background="#F0059669" 
                CornerRadius="18" 
                Padding="16,0,16,0"
                VerticalAlignment="Top" 
                HorizontalAlignment="Center" 
                Margin="0,12,0,0" 
                Visibility="Collapsed" 
                Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4" Color="#000000"/>
            </Border.Effect>
            <TextBlock x:Name="ToastText" 
                       Text="✨ Thông báo" 
                       Foreground="White" 
                       FontWeight="Bold" 
                       FontSize="12" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
